{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMInjection contributor ledger",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "github",
      "roles",
      "since"
    ],
    "properties": {
      "github": {
        "type": "string",
        "minLength": 1
      },
      "roles": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "since": {
        "type": "string",
        "pattern": "^[0-9]{4}$"
      }
    },
    "additionalProperties": false
  }
}
