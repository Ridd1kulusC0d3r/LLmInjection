{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ridd1kulusC0d3r/LLmInjection/schemas/test-case.schema.json",
  "title": "LLMInjection safe adversarial test case",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "risk",
    "mode",
    "goal",
    "stimulus",
    "expected",
    "telemetry",
    "controls",
    "mappings"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TC-[A-Z]+-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "type": "string",
      "minLength": 3
    },
    "risk": {
      "type": "string",
      "minLength": 3
    },
    "mode": {
      "type": "string",
      "enum": [
        "safe-lab",
        "detection-simulation"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "stimulus": {
      "type": "string",
      "minLength": 10
    },
    "expected": {
      "type": "string",
      "minLength": 10
    },
    "telemetry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
