{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMInjection source registry record",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "publisher",
    "grade",
    "role",
    "url",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SRC-"
    },
    "type": {
      "const": "source"
    },
    "name": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "grade": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "role": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
