{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMInjection dataset manifest",
  "type": "object",
  "required": [
    "name",
    "schema_version",
    "snapshot",
    "status",
    "license",
    "methodology",
    "datasets",
    "exports",
    "compatibility",
    "maintainer"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "snapshot": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "alpha",
        "beta",
        "stable"
      ]
    },
    "license": {
      "type": "string"
    },
    "methodology": {
      "type": "string"
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "compatibility": {
      "type": "object"
    },
    "maintainer": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
