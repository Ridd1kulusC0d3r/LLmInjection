{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMInjection relationship",
  "type": "object",
  "required": [
    "id",
    "type",
    "source",
    "relationship",
    "target",
    "confidence",
    "evidence_sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REL-"
    },
    "type": {
      "const": "relationship"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "relationship": {
      "type": "string",
      "minLength": 2
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "enum": [
        "confirmed",
        "high",
        "medium",
        "low",
        "unverified"
      ]
    },
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SRC-"
      }
    }
  },
  "additionalProperties": false
}
