{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMInjection intelligence source feeds",
  "type": "object",
  "required": [
    "schema_version",
    "policy",
    "feeds"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "feeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "url",
          "source_grade",
          "enabled",
          "max_items",
          "relevance_mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FEED-"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "atlas-releases",
              "github-releases",
              "github-commits",
              "github-advisories",
              "cisa-kev"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_grade": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "max_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "relevance_mode": {
            "enum": [
              "all",
              "keywords"
            ]
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
